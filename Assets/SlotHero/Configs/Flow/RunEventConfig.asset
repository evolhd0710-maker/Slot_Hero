      _illustrationId: "carve_power_\uB05D"
      _mood: "\uB178\uD30C\uAC00 \uB450 \uCE74\uB4DC\uC758 \uBB38\uC591\uC774 \uC0C8\uACA8\uC9C4 \uC0AC\uD0D5\uC744 \uAC74\uB124\uACE0 \uD754\uC801 \uC5C6\uC774 \uC0AC\uB77C\uC9C0\uB294 \uBD84\uC704\uAE30"
      _bodyText: "\uCE74\uB4DC\uB97C \uBCF8 \uC810\uC7C1\uC774\uAC00 \uAE30\uAD34\uD558\uAC8C \uC6C3\uC73C\uBA70 \uC0AC\uD0D5 \uD55C \uC54C\uC744 \uAC74\uB128\uB2E4. \uC544\uAE4C \uACE0\uB978 \uCE74\uB4DC \uB450 \uC7A5\uC758 \uBB38\uC591\uC774 \uBAA8\uB450 \uC0C8\uACA8\uC838 \uC788\uB294 \uC0AC\uD0D5\uC774\uB2E4. \uC0AC\uD0D5\uC744 \uC0BC\uD0A4\uB2C8 \uC54C \uC218 \uC5C6\uB294 \uD798\uC774 \uB290\uAEF4\uC9C4\uB2E4.\n\uB4A4\uB97C \uB3CC\uC544\uBCF4\uB2C8 \uD754\uC801\uB3C4 \uC5C6\uC774 \uC0AC\uB77C\uC838 \uC788\uB294 \uC810\uC7C1\uC774. \uB0A8\uC544\uC788\uB294 \uAC83\uC740 \uC785 \uC548\uC758 \uAE30\uBB18\uD55C \uB9DB \uBFD0\uC774\uB2E4. \uC5B4\uC9F8\uC120\uC9C0 \uCC1C\uCC1C\uD558\uC9C0\uB9CC \uAC00\uC57C\uD560 \uAE38\uC774 \uBA40\uB2E4."
